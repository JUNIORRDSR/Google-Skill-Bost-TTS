{
  "manifest_version": 3,
  "name": "Skills Narrador",
  "version": "1.1.0",
  "description": "Lee en voz alta la transcripción de los videos de Google Skills con una voz neural local, sincronizada con el párrafo que se va resaltando.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Skills Narrador",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "storage",
    "offscreen",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://huggingface.co/*",
    "https://*.hf.co/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.skills.google/*",
        "https://*.cloudskillsboost.google/*",
        "https://*.qwiklabs.com/*"
      ],
      "js": [
        "shared/defaults.js",
        "shared/voices.js",
        "content/transcript.js",
        "content/neural-engine.js",
        "content/narrator.js",
        "content/overlay.js",
        "content/main.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.youtube.com/embed/*",
        "https://www.youtube-nocookie.com/embed/*"
      ],
      "js": [
        "content/youtube-bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "toggle-narrator": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "Activar o desactivar el narrador"
    }
  }
}
